{
  "name": "duo-portfolio",
  "version": "1.0.0",
  "private": true,
  "description": "Portafolio colaborativo de dos desarrolladores - DevOps full-stack demo",
  "workspaces": [
    "apps/api",
    "apps/web"
  ],
  "scripts": {
    "dev": "npm-run-all --parallel dev:api dev:web",
    "dev:api": "npm run dev -w @duo/api",
    "dev:web": "npm run dev -w @duo/web",
    "build": "npm run build -w @duo/api && npm run build -w @duo/web",
    "start": "npm run start -w @duo/api",
    "test": "npm run test -w @duo/api",
    "test:unit": "npm run test:unit -w @duo/api",
    "test:integration": "npm run test:integration -w @duo/api",
    "test:e2e": "npm run test:e2e -w @duo/web"
  },
  "devDependencies": {
    "npm-run-all": "^4.1.5"
  },
  "engines": {
    "node": ">=20"
  }
}
